<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans-4.2.xsd" default-lazy-init="true">

    <!-- The telemetry adapters and flows need the ThresholdingService that thresholdingContext
         publishes. Collectd and Pollerd create that context, so depend on it to start it when
         both are disabled. -->
    <bean id="telemetrydContext" class="org.springframework.context.support.ClassPathXmlApplicationContext" depends-on="thresholdingContext">
     <constructor-arg>
       <list>
         <value>META-INF/opennms/applicationContext-telemetryDaemon.xml</value>
       </list>
     </constructor-arg>
      <!-- Telemetryd depends on ServiceTracker bean that is loaded with eventd.-->
     <constructor-arg ref="eventDaemonContext" />
   </bean>

</beans>
